{
  "name": "lullabot/drupal-symfony-lock",
  "description": "Use Drupal's lock backends with Symfony's locking API.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Andrew Berry",
      "email": "deviantintegral@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "drupal/core": "^10 || ^11",
    "symfony/lock": "^6 || ^7"
  },
  "autoload": {
    "psr-4": {
      "Lullabot\\DrupalSymfonyLock\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lullabot\\DrupalSymfonyLock\\Tests\\": "tests/src/"
    }
  },
  "extra": {
    "composer-version": "^1.6.3"
  },
  "require-dev": {
    "drupal/coder": "^8.3.30",
    "phpunit/phpunit": "^9.5 || ^10 || ^11",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": false,
      "drupal/core-composer-scaffold": false,
      "drupal/core-project-message": false,
      "php-http/discovery": false,
      "symfony/runtime": false
    }
  }
}
